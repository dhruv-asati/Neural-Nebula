{"schemaVersion":1,"notes":[{"id":"039fcd2e-ec60-40e3-b8a1-e8972a832fea","title":"Feature Engineering","content":"The process of selecting or transforming input variables so a learning algorithm can use useful patterns in the data.","tags":["machine learning","model","data","features"],"type":"CONCEPT","importance":50,"createdAt":"2026-10-19T03:26:31.104929300Z","updatedAt":"2026-10-19T03:26:31.104929300Z"},{"id":"245421a4-8fe1-4a09-9e15-159025e39dde","title":"Loss Function","content":"A measure of how far a model prediction is from the desired result. Training algorithms adjust model parameters to reduce this value.","tags":["machine learning","training","gradients","optimization"],"type":"CONCEPT","importance":50,"createdAt":"2026-10-19T03:26:24.076065900Z","updatedAt":"2026-10-19T03:26:24.076065900Z"},{"id":"41884cce-d6c0-4df4-9ac7-6883f65e6bd2","title":"Batch Normalization","content":"A neural-network technique that normalizes intermediate activations during training to help stabilize and speed up optimization.","tags":["neural networks","deep learning","training","normalization"],"type":"CONCEPT","importance":50,"createdAt":"2026-10-19T03:26:36.132392Z","updatedAt":"2026-10-19T03:26:36.132392Z"},{"id":"423a41c3-a09c-424f-b1d9-c2c228501333","title":"Model Evaluation","content":"The process of measuring a trained model with suitable metrics and data that was not used to fit it.","tags":["precision","recall","validation","metrics"],"type":"CONCEPT","importance":50,"createdAt":"2026-10-19T03:26:43.045453900Z","updatedAt":"2026-10-19T03:26:43.045453900Z"},{"id":"482c0e6a-6859-407f-9f43-115c86300463","title":"Overfitting","content":"When a model learns details and noise in its training data so closely that it performs poorly on new examples.","tags":["machine learning","regularization","model","generalization"],"type":"CONCEPT","importance":50,"createdAt":"2026-10-19T03:26:27.781269400Z","updatedAt":"2026-10-19T03:26:27.781269400Z"},{"id":"542a8496-f1c2-4df3-9566-4aa9de485a1f","title":"Gradient Descent","content":"An optimization method that iteratively adjusts model parameters in the direction that reduces the loss function. The learning rate controls the size of each update.","tags":["machine learning","training","gradients","optimization"],"type":"CONCEPT","importance":50,"createdAt":"2026-10-19T03:23:50.723888700Z","updatedAt":"2026-10-19T03:23:50.723888700Z"},{"id":"62206d0e-5596-4976-9337-7476c2266577","title":"Cross-Validation","content":"A method for estimating how well a model generalizes by repeatedly training and evaluating it on different partitions of the available data.","tags":["model","training","validation","evaluation"],"type":"CONCEPT","importance":50,"createdAt":"2026-10-19T03:26:29.390453Z","updatedAt":"2026-10-19T03:26:29.390453Z"},{"id":"6468625e-52cb-4a5a-a9c4-77b67ceb0773","title":"Reinforcement Learning","content":"A learning approach where an agent improves its behavior by taking actions and receiving rewards from an environment.","tags":["learning","agents","policy","rewards"],"type":"CONCEPT","importance":50,"createdAt":"2026-10-19T03:26:41.355313200Z","updatedAt":"2026-10-19T03:26:41.355313200Z"},{"id":"795c011e-56c9-4085-9b8b-5790c73477c6","title":"Embedding Space","content":"A vector space where items such as words or documents are represented so that meaningful similarity can be measured geometrically.","tags":["neural networks","vectors","semantic search","embeddings"],"type":"CONCEPT","importance":50,"createdAt":"2026-10-19T03:26:33.098986200Z","updatedAt":"2026-10-19T03:26:33.098986200Z"},{"id":"7ac02e66-54d0-458d-a6d5-e8d763806e42","title":"Transformer Attention","content":"A mechanism that lets each token weigh information from other tokens in a sequence. Self-attention uses query, key, and value vectors to build context-aware representations.","tags":["neural networks","attention","transformers","embeddings"],"type":"CONCEPT","importance":50,"createdAt":"2026-10-19T03:24:08.413737300Z","updatedAt":"2026-10-19T03:24:08.413737300Z"},{"id":"7f722c6a-59b1-42e0-8cfd-9e154ec8d617","title":"Convolutional Neural Network","content":"A neural-network architecture that uses local filters to detect spatial patterns, especially in images.","tags":["neural networks","image processing","deep learning","features"],"type":"CONCEPT","importance":50,"createdAt":"2026-10-19T03:26:37.815628200Z","updatedAt":"2026-10-19T03:26:37.815628200Z"},{"id":"aee9d7ea-f95e-491c-b13e-0e06d92042d9","title":"Recurrent Neural Network","content":"A neural-network architecture that carries information through a sequence, making it useful for ordered or time-based data.","tags":["neural networks","sequence","deep learning","time series"],"type":"CONCEPT","importance":50,"createdAt":"2026-10-19T03:26:39.648006300Z","updatedAt":"2026-10-19T03:26:39.648006300Z"},{"id":"algorithm-analysis","title":"Algorithm Analysis","content":"Analyze time and space cost using asymptotic notation.","tags":["complexity","graph","dsa","algorithms","search"],"type":"SUMMARY","importance":86,"createdAt":"2026-01-15T12:00:00Z","updatedAt":"2026-01-15T12:00:00Z"},{"id":"b26445ae-67d7-4653-bed0-8f914bf6bde5","title":"Epoch","content":"One complete pass through the training examples. Monitoring performance across epochs helps identify underfitting and overfitting.","tags":["neural networks","machine learning","model","training"],"type":"CONCEPT","importance":50,"createdAt":"2026-10-19T03:26:26.088804900Z","updatedAt":"2026-10-19T03:26:26.088804900Z"},{"id":"backpropagation","title":"Backpropagation","content":"Compute gradients through a network using the chain rule.","tags":["ml","model","learning","neural","optimization"],"type":"CONCEPT","importance":89,"createdAt":"2026-01-15T12:00:00Z","updatedAt":"2026-01-15T12:00:00Z"},{"id":"breadth-first-search","title":"Breadth-First Search","content":"BFS explores a graph level by level and finds shortest paths in unweighted graphs.","tags":["search","dsa","algorithms","graphs"],"type":"CONCEPT","importance":92,"createdAt":"2026-01-15T12:00:00Z","updatedAt":"2026-01-15T12:00:00Z"},{"id":"c92ac07d-3bf1-4c0f-808c-9283e661cbc0","title":"Tokenization","content":"Breaking text into tokens that a language model can process, such as words, subwords, or characters.","tags":["transformers","tokens","language models","text"],"type":"CONCEPT","importance":50,"createdAt":"2026-10-19T03:26:34.643230200Z","updatedAt":"2026-10-19T03:26:34.643230200Z"},{"id":"cpu-scheduling","title":"CPU Scheduling","content":"Scheduling policies choose which ready task receives processor time.","tags":["thread","process","memory","os","scheduling","systems"],"type":"CONCEPT","importance":79,"createdAt":"2026-01-15T12:00:00Z","updatedAt":"2026-01-15T12:00:00Z"},{"id":"d25b171d-ee08-43a9-b52e-65e4e8ce4739","title":"Regularization","content":"Techniques that discourage a model from fitting noise in its training data. L1 and L2 penalties add constraints to the learning objective and can improve generalization.","tags":["machine learning","model","overfitting","generalization"],"type":"CONCEPT","importance":50,"createdAt":"2026-10-19T03:24:02.408022700Z","updatedAt":"2026-10-19T03:24:02.408022700Z"},{"id":"depth-first-search","title":"Depth-First Search","content":"DFS explores one branch deeply before backtracking.","tags":["search","dsa","algorithms","graphs"],"type":"CONCEPT","importance":83,"createdAt":"2026-01-15T12:00:00Z","updatedAt":"2026-01-15T12:00:00Z"},{"id":"dsa-structures","title":"Data Structures","content":"Ways to organize data for efficient operations.","tags":["graph","search","dsa","algorithms"],"type":"CONCEPT","importance":90,"createdAt":"2026-01-15T12:00:00Z","updatedAt":"2026-01-15T12:00:00Z"},{"id":"embeddings","title":"Embeddings","content":"Dense vectors represent items so useful similarities can be computed.","tags":["ml","similarity","model","neural","learning"],"type":"RESOURCE","importance":78,"createdAt":"2026-01-15T12:00:00Z","updatedAt":"2026-01-15T12:00:00Z"},{"id":"graph-theory","title":"Graph Theory","content":"Graphs model vertices connected by edges and support traversal and path problems.","tags":["search","dsa","algorithms","graphs"],"type":"CONCEPT","importance":95,"createdAt":"2026-01-15T12:00:00Z","updatedAt":"2026-01-15T12:00:00Z"},{"id":"jaccard-index","title":"Jaccard Similarity","content":"Set similarity is intersection size divided by union size.","tags":["similarity","graph","dsa","algorithms","search"],"type":"CONCEPT","importance":76,"createdAt":"2026-01-15T12:00:00Z","updatedAt":"2026-01-15T12:00:00Z"},{"id":"machine-learning","title":"Machine Learning","content":"Models learn useful patterns from examples and data.","tags":["learning","neural","ml","model"],"type":"CONCEPT","importance":94,"createdAt":"2026-01-15T12:00:00Z","updatedAt":"2026-01-15T12:00:00Z"},{"id":"memory-management","title":"Memory Management","content":"Virtual memory maps process addresses to physical memory and storage.","tags":["thread","process","memory","os","scheduling","systems"],"type":"CONCEPT","importance":85,"createdAt":"2026-01-15T12:00:00Z","updatedAt":"2026-01-15T12:00:00Z"},{"id":"neural-networks","title":"Neural Networks","content":"Layered differentiable functions learn representations from data.","tags":["networks","ml","model","learning","neural"],"type":"CONCEPT","importance":96,"createdAt":"2026-01-15T12:00:00Z","updatedAt":"2026-01-15T12:00:00Z"},{"id":"operating-systems","title":"Operating Systems","content":"An operating system manages processes, memory, devices, and files.","tags":["thread","process","memory","os","scheduling","systems"],"type":"CONCEPT","importance":91,"createdAt":"2026-01-15T12:00:00Z","updatedAt":"2026-01-15T12:00:00Z"},{"id":"perceptron","title":"Perceptron","content":"A linear threshold unit combines weighted inputs and an activation rule.","tags":["networks","ml","model","learning","neural"],"type":"SUMMARY","importance":73,"createdAt":"2026-01-15T12:00:00Z","updatedAt":"2026-01-15T12:00:00Z"},{"id":"processes","title":"Processes","content":"A process is a running program with its own execution state and resources.","tags":["thread","process","memory","os","scheduling","systems"],"type":"CONCEPT","importance":86,"createdAt":"2026-01-15T12:00:00Z","updatedAt":"2026-01-15T12:00:00Z"},{"id":"research-question","title":"Open Research Question","content":"An isolated placeholder for a future idea not yet connected to the knowledge graph.","tags":["research"],"type":"QUESTION","importance":42,"createdAt":"2026-01-15T12:00:00Z","updatedAt":"2026-01-15T12:00:00Z"},{"id":"software-design","title":"Software Design","content":"Good design separates responsibilities and makes change easier to reason about.","tags":["engineering","design"],"type":"SUMMARY","importance":88,"createdAt":"2026-01-15T12:00:00Z","updatedAt":"2026-01-15T12:00:00Z"},{"id":"supervised-learning","title":"Supervised Learning","content":"Learn a mapping from labeled examples to predictions.","tags":["ml","training","model","learning","neural"],"type":"CONCEPT","importance":87,"createdAt":"2026-01-15T12:00:00Z","updatedAt":"2026-01-15T12:00:00Z"},{"id":"threads","title":"Threads","content":"Threads share a process address space while executing independent instruction streams.","tags":["scheduling","process","systems","os","concurrency","thread","memory"],"type":"CONCEPT","importance":82,"createdAt":"2026-01-15T12:00:00Z","updatedAt":"2026-01-15T12:00:00Z"},{"id":"union-find","title":"Union-Find","content":"Disjoint sets support connectivity queries with path compression and union by rank.","tags":["search","dsa","algorithms","graphs"],"type":"CONCEPT","importance":81,"createdAt":"2026-01-15T12:00:00Z","updatedAt":"2026-01-15T12:00:00Z"}],"relationships":[{"id":"0ccadcf2-2afb-41d3-8668-157fe63733bd","sourceNoteId":"6468625e-52cb-4a5a-a9c4-77b67ceb0773","targetNoteId":"machine-learning","type":"RELATED","origin":"MANUAL","similarityScore":null},{"id":"10cc0804-cd07